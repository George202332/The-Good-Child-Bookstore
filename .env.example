# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bookstore"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Redis (optional caching)
REDIS_URL="redis://localhost:6379"

# Payment gateways - test keys ONLY on Vercel "Preview" (staging), live keys ONLY on "Production". The environment decides, there is no switch.
# PayPal sandbox (Preview only)
PAYPAL_SANDBOX_CLIENT_ID=""
PAYPAL_SANDBOX_SECRET_KEY=""
PAYPAL_SANDBOX_WEBHOOK_ID=""
# PayPal live (Production only)
PAYPAL_LIVE_CLIENT_ID=""
PAYPAL_LIVE_SECRET_KEY=""
PAYPAL_LIVE_WEBHOOK_ID=""
# Paystack test (Preview only)
PAYSTACK_TEST_PUBLIC_KEY=""
PAYSTACK_TEST_SECRET_KEY=""
# Paystack live (Production only)
PAYSTACK_LIVE_PUBLIC_KEY=""
PAYSTACK_LIVE_SECRET_KEY=""
# Lulu - the same plain pair on Production and Preview (no base-address variable is needed: the site always uses api.lulu.com)
LULU_CLIENT_KEY=""
LULU_CLIENT_SECRET=""
RESEND_API_KEY=""
FROM_EMAIL="orders@thegoodchildbookstore.com"
# Scheduled health checks (GitHub Actions / Vercel cron send this as a password)
CRON_SECRET=""
# Optional, Preview only: the NAME (not the password) of the production Neon endpoint, e.g. ep-xxxx-123456. Staging then refuses to start if it is ever connected to it.
PRODUCTION_DATABASE_ENDPOINT=""
STRIPE_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Author/affiliate payouts are executed manually by an admin outside
# this system (see actions/admin.ts and actions/payouts.ts) — no
# payout-gateway environment variables are needed.

# Cloudflare Turnstile — CAPTCHA challenge on the Reader/Author signup
# forms (see lib/turnstile.ts). Create a widget at
# dash.cloudflare.com/?to=/:account/turnstile, "Managed" mode. Optional:
# with nothing set here, the challenge simply doesn't render and
# server-side verification is skipped — signup still works, just
# without this extra layer (the honeypot field and per-IP rate limit
# in actions/auth.ts are always active regardless).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Google infrastructure
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_SITE_URL="https://thegoodchildbookstore.com"

# Two-factor authentication — phone/SMS codes only (email codes reuse
# the existing Resend setup above, no new variables needed for that).
# Only required if a Reader or Author actually chooses the "Phone
# (SMS)" method in Settings — email-only 2FA works with nothing added
# here. Get these from a Twilio account (console.twilio.com): Account
# SID and Auth Token from the dashboard, and a phone number purchased
# under Phone Numbers, in E.164 format (e.g. +15551234567).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Optional plain-words label shown in the admin next to the database name, e.g. production / staging.
DATABASE_LABEL=""
# Password for the scheduled health check (/api/cron/service-health) and the other scheduled jobs.
CRON_SECRET=""
# Set to true on Production at launch (optional: the site also notices by itself when it runs with live payment keys only).
SITE_LAUNCHED=""
