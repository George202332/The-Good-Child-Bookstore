# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bookstore"

# Auth.js
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Redis (optional caching)
REDIS_URL="redis://localhost:6379"

# Payment gateways
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
LULU_API_KEY=""
RESEND_API_KEY=""
FROM_EMAIL="orders@thegoodchildbookstore.com"
STRIPE_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Wise (all author/affiliate payouts — Paystack's payout coverage is too
# limited internationally, so Wise handles every payout destination it
# supports, including M-Pesa)
WISE_API_TOKEN=""
WISE_PROFILE_ID=""
WISE_WEBHOOK_PUBLIC_KEY=""
WISE_ENV="sandbox"

# Google infrastructure
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_SITE_URL="https://thegoodchildbookstore.com"

# Two-factor authentication — phone/SMS codes only (email codes reuse
# the existing Resend setup above, no new variables needed for that).
# Only required if a Reader or Author actually chooses the "Phone
# (SMS)" method in Settings — email-only 2FA works with nothing added
# here. Get these from a Twilio account (console.twilio.com): Account
# SID and Auth Token from the dashboard, and a phone number purchased
# under Phone Numbers, in E.164 format (e.g. +15551234567).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
